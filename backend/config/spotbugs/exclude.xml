<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!--
      Storing an injected collaborator (service, repository, assembler) is
      intentional dependency injection, not a mutable-state leak. SpotBugs
      cannot distinguish the two, so we suppress it on constructors.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      DTOs are populated/serialized reflectively by Jackson, so their public
      fields look "unused" to static analysis.
    -->
    <Match>
        <Class name="~.*\.dto\..*"/>
        <Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD,UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

    <!--
      The application entry point holds a mutable dev toggle (isDev) that would
      normally come from a JVM arg or properties file. Intentional scaffolding.
    -->
    <Match>
        <Class name="ca.ulaval.glo4003.ProjectDBMain"/>
        <Bug pattern="MS_SHOULD_BE_FINAL"/>
    </Match>

</FindBugsFilter>
