{
  "name": "glo-4003-project-bootstrap",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "test": "pnpm -r --if-present test",
    "test:frontend": "pnpm --filter @glo-4003/frontend test",
    "build:frontend": "pnpm --filter @glo-4003/frontend build",
    "dev": "pnpm --filter @glo-4003/frontend dev",
    "backend:verify": "cd backend && ./gradlew build jacocoTestReport",
    "backend:build": "cd backend && ./gradlew assemble",
    "backend:test": "cd backend && ./gradlew check jacocoTestReport",
    "backend:format": "cd backend && ./gradlew spotlessApply"
  }
}
