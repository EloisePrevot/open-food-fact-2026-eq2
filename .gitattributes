# Normalize text files to LF in the repository.
* text=auto eol=lf

# Scripts that MUST stay LF so they run inside Linux containers.
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts stay CRLF.
*.bat text eol=crlf

# Binary files must never be normalized.
*.jar binary
*.db binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
